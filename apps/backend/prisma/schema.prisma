
generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  TEACHER
}

enum FormStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(TEACHER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments Assignment[]
  submissions Submission[]
  rubrics     Rubric[]

  @@map("users")
}

model Assignment {
  id                String   @id @default(uuid())
  title             String
  description       String?
  maxScore          Int      @default(100)
  dueDate           DateTime?
  requireUniqueId   Boolean  @default(false)
  otp               String
  status            FormStatus @default(DRAFT)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  teacherId         String
  teacher           User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  submissions       Submission[]
  
  rubricId          String?
  rubric            Rubric?      @relation(fields: [rubricId], references: [id], onDelete: SetNull)

  @@index([teacherId])
  @@map("assignments")
}

model Rubric {
  id        String   @id @default(uuid())
  name      String
  criteria  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacherId   String
  teacher     User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  assignments Assignment[]

  @@index([teacherId])
  @@map("rubrics")
}

model Submission {
  id              String           @id @default(uuid())
  fileKey         String           // S3 object key for internal reference
  score           Int?
  feedback        Json?           
  status          SubmissionStatus @default(PENDING)
  studentUniqueId String?         

  attemptNumber   Int              @default(1)  // Tracks multiple submissions

  submittedAt     DateTime         @default(now())
  gradedAt        DateTime?

  studentId       String
  student         User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  assignmentId    String
  assignment      Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([assignmentId])
  @@map("submissions")
  @@unique([studentId, assignmentId, attemptNumber])
}

enum SubmissionStatus {
  PENDING
  EVALUATING
  REVIEWING
  GRADED
  FAILED
}