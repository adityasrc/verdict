# -----------------------------
# Base image: Node.js (Debian Slim instead of Alpine)
# -----------------------------
FROM node:20-slim AS base
WORKDIR /app
RUN npm install -g pnpm

# -----------------------------
# Dependencies
# -----------------------------
FROM base AS deps
COPY package.json pnpm-lock.yaml* ./
COPY prisma ./prisma/
COPY prisma.config.ts ./
RUN pnpm install

ENV DATABASE_URL="postgresql://dummy:5432/dummy"
RUN pnpm exec prisma generate

# -----------------------------
# Build worker
# -----------------------------
FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN pnpm run build

# -----------------------------
# Production image
# -----------------------------
FROM base AS prod
WORKDIR /app

# 1. Install Python (Debian way - much cleaner)
RUN apt-get update && \
    apt-get install -y python3 python3-pip && \
    rm -rf /var/lib/apt/lists/*

# 2. Node Deps
COPY package.json pnpm-lock.yaml* ./
RUN pnpm install --prod

# 3. Prisma setup
COPY --from=deps /app/prisma ./prisma
COPY --from=deps /app/prisma.config.ts ./
ENV DATABASE_URL="postgresql://dummy:5432/dummy"
RUN pnpm exec prisma generate

# 4. Install Python requirements (Pre-built wheels, no C++ compilers needed!)
COPY workers/python/requirements.txt ./workers/python/
RUN pip3 install --no-cache-dir --default-timeout=100 --retries=5 \
    -r workers/python/requirements.txt --break-system-packages

# 5. Copy built files
COPY --from=builder /app/dist ./dist
COPY workers/python ./dist/workers/python

# 6. Security
RUN chown -R node:node /app
USER node

# Start the worker
CMD ["node", "dist/workers/SubmissionWorker.js"]