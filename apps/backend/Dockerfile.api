# -----------------------------
# Base Image (Node.js runtime)
# -----------------------------
FROM node:20-alpine AS base
WORKDIR /app
# Install pnpm globally
RUN npm install -g pnpm

# -----------------------------
# Dependencies Stage (All deps for build)
# -----------------------------
FROM base AS deps
COPY package.json pnpm-lock.yaml* ./
COPY prisma ./prisma/
COPY prisma.config.ts ./

# Install ALL dependencies (including devDependencies like TypeScript)
RUN pnpm install

# Generate Prisma client
ENV DATABASE_URL="postgresql://dummy:5432/dummy"
RUN pnpm exec prisma generate

# -----------------------------
# Build Stage (Compile TypeScript)
# -----------------------------
FROM deps AS builder
COPY . .
# Build API and WebSocket into dist/
RUN pnpm build

# -----------------------------
# Final Production Image
# -----------------------------
FROM base AS prod
WORKDIR /app

# 1. Copy package files
COPY package.json pnpm-lock.yaml* ./

# 2. Install ONLY production dependencies (keeps image small)
RUN pnpm install --prod

# 3. Copy Prisma files and generate client for the prod environment
COPY --from=deps /app/prisma ./prisma
COPY --from=deps /app/prisma.config.ts ./
ENV DATABASE_URL="postgresql://dummy:5432/dummy"
RUN pnpm exec prisma generate

# 4. Copy only the compiled output from the builder stage
COPY --from=builder /app/dist ./dist

# 5. Give ownership of the /app directory to the 'node' user
RUN chown -R node:node /app

# 6. Switch to non-root user for security
USER node

# Start the server
CMD ["node", "dist/index.js"]