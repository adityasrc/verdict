# VERDICT - Local Environment Template
# Copy this to .env and replace placeholders where necessary.

# --- Core Server ---
NODE_ENV=development
HTTP_PORT=4000
WS_PORT=8000
CORS_ORIGIN=http://localhost:5173
RUN_WORKER_IN_API=false

# --- Database (Postgres) ---
POSTGRES_DB=verdict_db
POSTGRES_USER=verdict_user
POSTGRES_PASSWORD=local_secret
POSTGRES_PORT=5432
DATABASE_URL=postgresql://verdict_user:local_secret@localhost:5432/verdict_db

# --- Storage (Local MinIO Default) ---
# Replace with Cloudflare R2 credentials for production
R2_ENDPOINT=http://127.0.0.1:9000
BUCKET_NAME=verdict-assets
ACCESSKEYID=minioadmin
SECRETACCESSKEY=minioadmin
PUBLIC_ENDPOINT=http://127.0.0.1:9000/verdict-assets

# --- Redis (BullMQ & Pub/Sub) ---
REDIS_URL=redis://localhost:6379

# --- Authentication (JWT) ---
JWT_SECRET=dev_access_secret_key_123
JWT_REFRESH_SECRET=dev_refresh_secret_key_456
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- External APIs ---
GEMINI_API_KEY=your_google_ai_studio_key
GEMINI_MODEL=gemini-3.7-flash

# --- Python Binary (python3 on Linux/Mac, python on Windows) ---
PYTHON_BIN=python3

# --- Frontend Variables (Vite) ---
VITE_API_URL=http://localhost:4000/api
VITE_WS_URL=http://localhost:4000
